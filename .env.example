# ===========================================
# GymMind Docker 基础设施环境变量
# 复制为 .env 后按需修改（start-infrastructure.bat 可自动生成）
# ===========================================

COMPOSE_PROJECT_NAME=gymmind

# ---------- MySQL（默认使用本机 MySQL，不用 Docker）----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=gymmind
MYSQL_USER=root
MYSQL_PASSWORD=your_local_mysql_password
# 若改为 1，启动脚本会附带 --profile mysql 拉起容器内 MySQL
USE_DOCKER_MYSQL=0
MYSQL_HOST_PORT=3307

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_HOST_PORT=6379

# ---------- Elasticsearch（容器内 9200，映射到宿主机 ES_HOST_PORT）----------
ES_HOST_PORT=9202
GYMMIND_ES_URL=http://localhost:9202

# ---------- Milvus ----------
MILVUS_HOST=localhost
MILVUS_PORT=19530
GYMMIND_MILVUS_URL=http://localhost:19530

# ---------- MinIO（Milvus 与知识库对象存储共用）----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
GYMMIND_OBJECT_STORE=minio
GYMMIND_OBJECT_STORE_MINIO_ENDPOINT=http://localhost:9000
GYMMIND_OBJECT_STORE_MINIO_ACCESS_KEY=minioadmin
GYMMIND_OBJECT_STORE_MINIO_SECRET_KEY=minioadmin123
GYMMIND_OBJECT_STORE_MINIO_BUCKET=gymmind

# ---------- 后端 Spring（Docker 全栈开发）----------
SPRING_PROFILES_ACTIVE=dev,docker
GYMMIND_SEARCH_KEYWORD_BACKEND=elasticsearch
GYMMIND_SEARCH_VECTOR_BACKEND=milvus
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ---------- 应用密钥（生产务必修改）----------
JWT_SECRET=GymMind-local-dev-secret-change-me-please-32bytes
PLATFORM_ADMIN_EMAIL=admin@qq.com
PLATFORM_ADMIN_PASSWORD=123456

# ---------- AI（可选，未配置时使用本地降级）----------
AI_API_KEY=
AI_API_BASE_URL=https://api.deepseek.com/v1
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
