# GymMind 本地全栈配置（复制为 .env 后修改 MYSQL_PASSWORD 与 DASHSCOPE_API_KEY）
# 启动：start-infrastructure.bat → start-all.bat（或 IDEA profile=dev）
# 说明：docs/CONFIGURATION.md

COMPOSE_PROJECT_NAME=gymmind

# ---------- 必填 ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=gymmind
MYSQL_USER=root
MYSQL_PASSWORD=your_local_mysql_password
DASHSCOPE_API_KEY=

# ---------- Docker 端口（一般不用改）----------
USE_DOCKER_MYSQL=0
MYSQL_HOST_PORT=3307
REDIS_HOST=localhost
REDIS_HOST_PORT=6379
ES_HOST_PORT=9202
MILVUS_HOST=localhost
MILVUS_PORT=19530
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ONLYOFFICE_HOST_PORT=8088
ONLYOFFICE_JWT_SECRET=GymMindOnlyOfficeDevSecretChangeMe32
# 拉不下来时用国内代理镜像，见 docs/onlyoffice-docker-pull-cn.md
# ONLYOFFICE_IMAGE=docker.m.daocloud.io/onlyoffice/documentserver:8.2.2

# ---------- 后端（默认值已在 application-dev.yml，仅在有需要时取消注释）----------
# GYMMIND_KNOWLEDGE_ONLYOFFICE_ENABLED=true
# GYMMIND_ONLYOFFICE_DOCUMENT_SERVER_URL=http://localhost:8088
# GYMMIND_ONLYOFFICE_INTERNAL_API_BASE_URL=http://host.docker.internal:8080
# SPRING_PROFILES_ACTIVE=dev
# GYMMIND_KNOWLEDGE_INGEST_TWO_PHASE=false
# GYMMIND_KNOWLEDGE_INGEST_MAX_ATTEMPTS=5
# JWT_SECRET=GymMind-local-dev-secret-change-me-please-32bytes
# PLATFORM_ADMIN_PASSWORD=123456
